# Pooled connection, used by the app at runtime
DATABASE_URL="postgresql://user:password@localhost:5432/dyvina?schema=public"
# Direct connection, used by the Prisma CLI (migrate, studio). Same as DATABASE_URL when there is no pooler.
DIRECT_URL="postgresql://user:password@localhost:5432/dyvina?schema=public"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Used by `bun run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Vercel Blob read/write token for product photo uploads
BLOB_READ_WRITE_TOKEN=""
